<%- include('../partials/header') %>
    <div style="margin-top: 40px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h1>Budgets</h1>
            <button onclick="document.getElementById('categoryModal').style.display='flex'" class="btn-outline">
                <i data-lucide="plus" style="width: 16px; height: 16px; margin-right: 4px; vertical-align: middle;"></i>
                New Category
            </button>
        </div>

        <div class="dashboard-grid">
            <div class="auth-card">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <h3>Set Budget</h3>
                </div>
                <form action="/budgets/add" method="POST" style="margin-top:20px;">
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                            <label style="margin: 0;">Category</label>
                            <a href="javascript:void(0)" onclick="document.getElementById('categoryModal').style.display='flex'" 
                               style="color: var(--primary); font-size: 0.8rem; text-decoration: none; font-weight: 600;">+ Add Category</a>
                        </div>
                        <select name="categoryId" required>
                            <% if (categories && categories.length > 0) { %>
                                <% categories.forEach(c => { %>
                                    <option value="<%= c.id || c._id %>">
                                        <%= c.name %>
                                    </option>
                                <% }) %>
                            <% } else { %>
                                <option value="" disabled selected>No expense categories — Click '+' to add a category</option>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Amount (<%= userCurrency %>)</label>
                        <input type="number" name="amount" step="0.01" min="0.01" placeholder="0.00" required>
                    </div>
                    <div class="form-group">
                        <label>Remarks</label>
                        <input type="text" name="description" placeholder="e.g. Monthly groceries limit">
                    </div>
                    <button type="submit" class="btn-primary" style="width:100%;">Save Budget</button>
                </form>
            </div>
            <div class="stat-card" style="grid-column: span 2;">
                <h3>Active Budgets</h3>
                <div style="margin-top: 20px;">
                    <% if (budgets && budgets.length > 0) { %>
                        <% budgets.forEach(b => { %>
                            <% 
                                const catIdStr = b.categoryId ? (b.categoryId._id || b.categoryId).toString() : '';
                                const catName = b.Category ? b.Category.name : (b.categoryId ? b.categoryId.name : 'Unknown Category');
                                const safeDesc = (b.description || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                            %>
                            <div
                                style="display:flex; justify-content:space-between; align-items:center; padding:15px 0; border-bottom:1px solid var(--border);">
                                <div>
                                    <div style="font-weight: 600; color: var(--text-main);">
                                        <%= catName %>
                                    </div>
                                    <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
                                        <%= b.description || 'No remarks' %>
                                    </div>
                                </div>
                                <span style="font-weight: 700; color: var(--primary); font-size: 1.1rem;">
                                    <%= userCurrency %>
                                    <%= parseFloat(b.convertedAmount || 0).toLocaleString(undefined,
                                        {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                </span>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <button class="btn-outline" style="padding: 5px 12px; font-size: 0.8rem;"
                                        onclick="openEditBudgetModal('<%= b.id || b._id %>', '<%= catIdStr %>', '<%= b.convertedAmount %>', '<%= safeDesc %>')">
                                        Edit
                                    </button>
                                    <form action="/budgets/<%= b.id || b._id %>?_method=DELETE" method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this budget?')">
                                        <button type="submit" class="btn-outline"
                                            style="padding: 5px 12px; font-size: 0.8rem; border-color: var(--danger); color: var(--danger);">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="text-align: center; padding: 40px; color: var(--text-muted);">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
                                <i data-lucide="piggy-bank" style="width: 40px; height: 40px; opacity: 0.5;"></i>
                                <p>No budgets set yet. Start by setting your first budget!</p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Budget Modal -->
    <div id="editBudgetModal" class="modal-overlay" style="display:none;">
        <div class="modal-box">
            <h3 style="margin-bottom: 16px;">Edit Budget</h3>
            <form action="/budgets/update?_method=PUT" method="POST">
                <input type="hidden" name="id" id="editBudgetId">
                <div class="form-group">
                    <label>Category</label>
                    <select name="categoryId" id="editBudgetCategory" required>
                        <% if (categories && categories.length > 0) { %>
                            <% categories.forEach(c => { %>
                                <option value="<%= c.id || c._id %>">
                                    <%= c.name %>
                                </option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="form-group">
                    <label>Amount (<%= userCurrency %>)</label>
                    <input type="number" name="amount" id="editBudgetAmount" step="0.01" min="0.01" required>
                </div>
                <div class="form-group">
                    <label>Remarks</label>
                    <input type="text" name="description" id="editBudgetDescription">
                </div>
                <button type="submit" class="btn-primary" style="width:100%;">Update Budget</button>
                <button type="button" onclick="document.getElementById('editBudgetModal').style.display='none'"
                    class="btn-outline" style="width:100%; margin-top:10px;">Cancel</button>
            </form>
        </div>
    </div>

    <!-- Category Modal -->
    <div id="categoryModal" class="modal-overlay" style="display:none;">
        <div class="modal-box">
            <h3 style="margin-bottom: 16px;">Add New Category</h3>
            <form action="/categories/add" method="POST">
                <input type="hidden" name="redirectTo" value="/budgets">
                <div class="form-group">
                    <label>Category Name</label>
                    <input type="text" name="name" required placeholder="e.g. Subscriptions">
                </div>
                <div class="form-group">
                    <label>Type</label>
                    <select name="type">
                        <option value="expense" selected>Expense</option>
                        <option value="income">Income</option>
                    </select>
                </div>
                <button type="submit" class="btn-primary" style="width:100%;">Create Category</button>
                <button type="button" onclick="document.getElementById('categoryModal').style.display='none'"
                    class="btn-outline" style="width:100%; margin-top:10px;">Cancel</button>
            </form>
        </div>
    </div>

    <script>
        function openEditBudgetModal(id, categoryId, amount, description) {
            document.getElementById('editBudgetId').value = id;
            document.getElementById('editBudgetCategory').value = categoryId;
            document.getElementById('editBudgetAmount').value = amount;
            document.getElementById('editBudgetDescription').value = description;
            document.getElementById('editBudgetModal').style.display = 'flex';
        }
    </script>
    <%- include('../partials/footer') %>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> | MoneyLens
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body>
    <div class="container">
        <nav style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0;">
            <a href="<%= user ? '/dashboard' : '/' %>" class="logo">MoneyLens</a>
            <div class="nav-links" style="display: flex; align-items: center; gap: 20px;">
                <% if (user) { %>
                    <form action="/user/update-currency" method="POST" style="display:inline;">
                        <select name="currency" class="currency-select" onchange="this.form.submit()">
                            <option value="USD" <%=user.currency==='USD' ? 'selected' : '' %>>USD $</option>
                            <option value="INR" <%=user.currency==='INR' ? 'selected' : '' %>>INR ₹</option>
                            <option value="EUR" <%=user.currency==='EUR' ? 'selected' : '' %>>EUR €</option>
                            <option value="GBP" <%=user.currency==='GBP' ? 'selected' : '' %>>GBP £</option>
                            <option value="JPY" <%=user.currency==='JPY' ? 'selected' : '' %>>JPY ¥</option>
                        </select>
                    </form>

                    <a href="/dashboard">Dashboard</a>
                    <a href="/transactions">Transactions</a>
                    <a href="/auth/ai" style="color: var(--primary); display: flex; align-items: center; gap: 5px; font-weight: 600;">
                        <i data-lucide="sparkles" style="width: 15px;"></i> AI Advisor
                    </a>

                    <!-- Hamburger Dropdown -->
                    <div class="dropdown">
                        <div class="menu-trigger">
                            <i data-lucide="menu" style="width: 18px;"></i>
                            <span>More</span>
                        </div>
                        <div class="dropdown-content">
                            <a href="/budgets"><i data-lucide="pie-chart" style="width: 16px;"></i> Budgets</a>
                            <a href="/savings"><i data-lucide="piggy-bank" style="width: 16px;"></i> Savings</a>
                            <a href="/reports"><i data-lucide="bar-chart-3" style="width: 16px;"></i> Reports</a>
                            <a href="/reports/anomalies"><i data-lucide="alert-triangle" style="width: 16px;"></i> Anomalies</a>
                            <a href="/blockchain" style="color: #0891b2;"><i data-lucide="link" style="width: 16px;"></i> Blockchain</a>
                            <hr style="border: none; border-top: 1px solid var(--border); margin: 4px 0;">
                            <a href="/user/profile"><i data-lucide="user-circle" style="width: 16px;"></i> My Profile</a>
                            <a href="/auth/logout" style="color: var(--danger);">
                                <i data-lucide="log-out" style="width: 16px;"></i> Logout
                            </a>
                        </div>
                    </div>

                <% } else { %>
                    <a href="/auth/login" style="color: var(--text-secondary); font-weight: 500;">Login</a>
                    <a href="/auth/register" class="btn-primary">Get Started</a>
                <% } %>
            </div>
        </nav>

        <!-- Flash Messages -->
        <% if (locals.error && error.length > 0) { %>
            <div class="flash-error">
                <i data-lucide="alert-circle" style="width: 16px; flex-shrink: 0;"></i>
                <%= error %>
            </div>
        <% } %>

        <% if (locals.success && success.length > 0) { %>
            <div class="flash-success">
                <i data-lucide="check-circle" style="width: 16px; flex-shrink: 0;"></i>
                <%= success %>
            </div>
        <% } %>

        <script>
            lucide.createIcons();

            // Hamburger Menu Logic
            const menuTrigger = document.querySelector('.menu-trigger');
            const dropdownContent = document.querySelector('.dropdown-content');

            if (menuTrigger && dropdownContent) {
                menuTrigger.addEventListener('click', (e) => {
                    e.stopPropagation();
                    dropdownContent.classList.toggle('show');
                    menuTrigger.classList.toggle('active');
                });

                document.addEventListener('click', (e) => {
                    if (!dropdownContent.contains(e.target) && !menuTrigger.contains(e.target)) {
                        dropdownContent.classList.remove('show');
                        menuTrigger.classList.remove('active');
                    }
                });
            }
        </script>

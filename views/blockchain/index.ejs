<%- include('../partials/header') %>

<style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap');

    :root {
        --chain-primary: #6366f1;
        --chain-secondary: #8b5cf6;
        --chain-accent: #22d3ee;
        --chain-success: #10b981;
        --chain-danger: #ef4444;
        --chain-warning: #f59e0b;
        --chain-bg: #0f0f1a;
        --chain-card: rgba(255,255,255,0.04);
        --chain-border: rgba(99,102,241,0.25);
        --chain-glow: 0 0 30px rgba(99,102,241,0.15);
    }

    .blockchain-hero {
        background: linear-gradient(135deg, rgba(99,102,241,0.12) 0%, rgba(139,92,246,0.08) 50%, rgba(34,211,238,0.08) 100%);
        border: 1px solid var(--chain-border);
        border-radius: 20px;
        padding: 32px 40px;
        margin-bottom: 36px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        position: relative;
        overflow: hidden;
    }
    .blockchain-hero::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 200px; height: 200px;
        background: radial-gradient(circle, rgba(99,102,241,0.15), transparent 70%);
        pointer-events: none;
    }

    .hero-title {
        font-size: 2.2rem;
        font-weight: 700;
        background: linear-gradient(135deg, #6366f1, #22d3ee);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0 0 6px;
        letter-spacing: -1px;
    }
    .hero-subtitle {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin: 0;
    }

    .chain-stats {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }
    .chain-stat {
        text-align: center;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--chain-border);
        border-radius: 14px;
        padding: 14px 22px;
        min-width: 100px;
    }
    .chain-stat-value {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--chain-accent);
        line-height: 1;
        font-family: 'JetBrains Mono', monospace;
    }
    .chain-stat-label {
        font-size: 0.72rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 5px;
    }

    /* Verify Banner */
    .verify-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 24px;
        border-radius: 14px;
        margin-bottom: 28px;
        gap: 16px;
        flex-wrap: wrap;
        border: 1px solid;
        transition: all 0.3s;
    }
    .verify-banner.valid {
        background: rgba(16,185,129,0.08);
        border-color: rgba(16,185,129,0.3);
    }
    .verify-banner.invalid {
        background: rgba(239,68,68,0.08);
        border-color: rgba(239,68,68,0.3);
    }
    .verify-badge {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        font-size: 1rem;
    }
    .verify-badge .dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }
    .valid .dot { background: var(--chain-success); box-shadow: 0 0 8px var(--chain-success); }
    .invalid .dot { background: var(--chain-danger); box-shadow: 0 0 8px var(--chain-danger); }
    @keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.7; }
    }
    .verify-btn {
        background: linear-gradient(135deg, var(--chain-primary), var(--chain-secondary));
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }
    .verify-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(99,102,241,0.4);
    }
    .verify-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    /* Chain visualization */
    .chain-section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .chain-section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(to right, var(--chain-border), transparent);
    }

    .blocks-grid {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .block-connector {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 36px;
        position: relative;
    }
    .block-connector::before {
        content: '';
        position: absolute;
        top: 0; bottom: 0;
        left: 50%;
        width: 2px;
        background: linear-gradient(to bottom, var(--chain-primary), var(--chain-secondary));
        opacity: 0.4;
    }
    .connector-arrow {
        width: 28px; height: 28px;
        background: var(--chain-card);
        border: 1px solid var(--chain-border);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
        position: relative;
        color: var(--chain-primary);
        font-size: 0.75rem;
    }

    .block-card {
        background: var(--chain-card);
        border: 1px solid var(--chain-border);
        border-radius: 18px;
        padding: 24px 28px;
        position: relative;
        overflow: hidden;
        transition: all 0.25s;
    }
    .block-card:hover {
        border-color: rgba(99,102,241,0.5);
        box-shadow: var(--chain-glow);
        transform: translateX(3px);
    }
    .block-card.genesis {
        border-color: rgba(34,211,238,0.3);
        background: rgba(34,211,238,0.04);
    }
    .block-card.amendment {
        border-color: rgba(245,158,11,0.35);
        background: rgba(245,158,11,0.04);
    }
    .block-card.deletion {
        border-color: rgba(239,68,68,0.35);
        background: rgba(239,68,68,0.04);
    }
    .block-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(to right, var(--chain-primary), var(--chain-secondary), var(--chain-accent));
        border-radius: 18px 18px 0 0;
        opacity: 0.6;
    }
    .block-card.genesis::before {
        background: linear-gradient(to right, var(--chain-accent), var(--chain-success));
    }
    .block-card.amendment::before {
        background: linear-gradient(to right, #f59e0b, #d97706);
    }
    .block-card.deletion::before {
        background: linear-gradient(to right, #ef4444, #b91c1c);
    }

    /* Amendment before/after diff panel */
    .diff-panel {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 12px;
        align-items: start;
        background: rgba(0,0,0,0.15);
        border-radius: 12px;
        padding: 16px;
        border: 1px solid rgba(245,158,11,0.2);
    }
    .diff-box {
        background: rgba(255,255,255,0.03);
        border-radius: 10px;
        padding: 12px;
    }
    .diff-box-label {
        font-size: 0.66rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }
    .diff-box-label.before { color: #ef4444; }
    .diff-box-label.after  { color: #10b981; }
    .diff-arrow {
        font-size: 1.4rem;
        color: #f59e0b;
        align-self: center;
        text-align: center;
    }
    .diff-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-size: 0.78rem;
        margin-bottom: 4px;
    }
    .diff-key { color: var(--text-muted); }
    .diff-val { font-family: 'JetBrains Mono', monospace; font-weight: 500; }
    .diff-changed { color: #f59e0b; }

    /* Deletion snapshot panel */
    .deletion-panel {
        grid-column: 1 / -1;
        background: rgba(239,68,68,0.06);
        border: 1px solid rgba(239,68,68,0.2);
        border-radius: 12px;
        padding: 16px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 10px;
    }

    .block-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 18px;
        gap: 12px;
        flex-wrap: wrap;
    }
    .block-index-badge {
        background: linear-gradient(135deg, var(--chain-primary), var(--chain-secondary));
        color: white;
        padding: 5px 14px;
        border-radius: 100px;
        font-size: 0.78rem;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }
    .genesis .block-index-badge {
        background: linear-gradient(135deg, var(--chain-accent), var(--chain-success));
    }
    .block-timestamp {
        color: var(--text-muted);
        font-size: 0.8rem;
        font-family: 'JetBrains Mono', monospace;
    }

    .block-body {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    @media (max-width: 700px) {
        .block-body { grid-template-columns: 1fr; }
    }

    .block-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .block-field-label {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: var(--text-muted);
        font-weight: 600;
    }
    .block-field-value {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: var(--text-main);
        word-break: break-all;
        cursor: pointer;
        transition: color 0.2s;
    }
    .block-field-value:hover {
        color: var(--chain-accent);
    }
    .block-field-value.hash {
        color: var(--chain-accent);
    }
    .block-field-value.prev-hash {
        color: rgba(99,102,241,0.7);
    }
    .block-field-value.amount-income {
        color: var(--chain-success);
        font-weight: 700;
    }
    .block-field-value.amount-expense {
        color: var(--chain-danger);
        font-weight: 700;
    }

    .block-full-width {
        grid-column: 1 / -1;
    }

    .copy-hint {
        font-size: 0.65rem;
        color: var(--text-muted);
        opacity: 0;
        transition: opacity 0.2s;
        margin-top: 2px;
    }
    .block-field:hover .copy-hint { opacity: 1; }

    .copied-toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: var(--chain-primary);
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        box-shadow: 0 8px 24px rgba(99,102,241,0.5);
        z-index: 9999;
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.3s;
    }
    .copied-toast.show {
        opacity: 1;
        transform: translateY(0);
    }

    /* Empty state */
    .empty-chain {
        text-align: center;
        padding: 60px 20px;
        color: var(--text-muted);
    }

    /* Mining spinner */
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
    .spinner {
        display: inline-block;
        width: 14px; height: 14px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
    }
</style>

<div style="margin-top: 40px;">

    <!-- Hero Header -->
    <div class="blockchain-hero">
        <div>
            <div class="hero-title">⛓ Blockchain Explorer</div>
            <p class="hero-subtitle">Immutable, cryptographically-secured transaction ledger</p>
        </div>
        <div class="chain-stats">
            <div class="chain-stat">
                <div class="chain-stat-value"><%= blocks.length %></div>
                <div class="chain-stat-label">Total Blocks</div>
            </div>
            <div class="chain-stat">
                <div class="chain-stat-value"><%= blocks.length > 0 ? blocks.length - 1 : 0 %></div>
                <div class="chain-stat-label">Transactions</div>
            </div>
            <div class="chain-stat">
                <div class="chain-stat-value"><%= difficulty %></div>
                <div class="chain-stat-label">Difficulty</div>
            </div>
            <div class="chain-stat">
                <div class="chain-stat-value" style="color: <%= verifyResult.valid ? 'var(--chain-success)' : 'var(--chain-danger)' %>">
                    <%= verifyResult.valid ? '✓' : '✗' %>
                </div>
                <div class="chain-stat-label">Chain Valid</div>
            </div>
        </div>
    </div>

    <!-- Verify Banner -->
    <div class="verify-banner <%= verifyResult.valid ? 'valid' : 'invalid' %>" id="verifyBanner">
        <div class="verify-badge">
            <div class="dot"></div>
            <span>
                <% if (verifyResult.valid) { %>
                    Chain Integrity Verified — All <%= verifyResult.blockCount %> blocks are authentic
                <% } else { %>
                    Chain Integrity FAILED — <%= verifyResult.reason || 'Tampering detected' %>
                <% } %>
            </span>
        </div>
        <button class="verify-btn" id="verifyBtn" onclick="runVerify()">
            <i data-lucide="shield-check" style="width: 16px;"></i>
            Re-verify Chain
        </button>
    </div>

    <!-- Block Explorer -->
    <div class="chain-section-title">
        <i data-lucide="layers" style="width: 18px; color: var(--chain-primary);"></i>
        Block Chain — Newest First
    </div>

    <% if (blocks && blocks.length > 0) { %>
        <div class="blocks-grid" id="blocksGrid">
            <% blocks.forEach((block, i) => { %>
                <% if (i > 0) { %>
                    <div class="block-connector">
                        <div class="connector-arrow">↑</div>
                    </div>
                <% } %>

                <div class="block-card <%= block.eventType || (block.index === 0 ? 'genesis' : 'transaction') %>">
                    <div class="block-header">
                        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                            <div class="block-index-badge"
                                style="<%
                                    const et = block.eventType || (block.index===0?'genesis':'transaction');
                                    if (et==='genesis')   { %>background:linear-gradient(135deg,#22d3ee,#10b981)<%
                                    } else if (et==='amendment') { %>background:linear-gradient(135deg,#f59e0b,#d97706)<%
                                    } else if (et==='deletion')  { %>background:linear-gradient(135deg,#ef4444,#b91c1c)<%
                                    } else { %>background:linear-gradient(135deg,#6366f1,#8b5cf6)<% } %>">
                                <%
                                    if (block.index === 0)               { %>🌱 GENESIS<%
                                    } else if (et === 'amendment')        { %>✏️ AMENDED #<%= block.index %><%
                                    } else if (et === 'deletion')         { %>🗑️ DELETED #<%= block.index %><%
                                    } else                               { %>BLOCK #<%= block.index %><% } %>
                            </div>

                            <% if (et === 'transaction' && block.data && block.data.type) { %>
                                <span style="font-size: 0.78rem; padding: 4px 10px; border-radius: 100px; font-weight: 600;
                                    background: <%= block.data.type === 'income' ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)' %>;
                                    color: <%= block.data.type === 'income' ? 'var(--chain-success)' : 'var(--chain-danger)' %>;
                                    border: 1px solid <%= block.data.type === 'income' ? 'rgba(16,185,129,0.3)' : 'rgba(239,68,68,0.3)' %>;">
                                    <%= block.data.type === 'income' ? '↑ Income' : '↓ Expense' %>
                                </span>
                            <% } %>
                            <% if (et === 'amendment') { %>
                                <span style="font-size: 0.75rem; color:#f59e0b; background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.25); padding:3px 10px; border-radius:100px;">Audit Trail</span>
                            <% } %>
                            <% if (et === 'deletion') { %>
                                <span style="font-size: 0.75rem; color:#ef4444; background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.25); padding:3px 10px; border-radius:100px;">Permanent Record</span>
                            <% } %>
                        </div>
                        <div class="block-timestamp">
                            <%= new Date(block.timestamp).toLocaleString() %>
                        </div>
                    </div>

                    <div class="block-body">

                        <!-- Hash -->
                        <div class="block-field" onclick="copyToClipboard('<%= block.hash %>')">
                            <div class="block-field-label">Block Hash (SHA-256)</div>
                            <div class="block-field-value hash"><%= block.hash.substring(0, 20) %>...<%= block.hash.substring(56) %></div>
                            <div class="copy-hint">Click to copy full hash</div>
                        </div>

                        <!-- Previous Hash -->
                        <div class="block-field" onclick="copyToClipboard('<%= block.previousHash %>')">
                            <div class="block-field-label">Previous Hash</div>
                            <div class="block-field-value prev-hash">
                                <% if (block.index === 0) { %>
                                    0000...0000 (Genesis)
                                <% } else { %>
                                    <%= block.previousHash.substring(0, 20) %>...<%= block.previousHash.substring(56) %>
                                <% } %>
                            </div>
                            <div class="copy-hint">Click to copy full hash</div>
                        </div>

                        <% if (block.index === 0) { %>
                            <!-- Genesis data -->
                            <div class="block-field block-full-width">
                                <div class="block-field-label">Genesis Data</div>
                                <div class="block-field-value" style="color: var(--chain-accent);">
                                    <%= block.data.message || JSON.stringify(block.data) %>
                                </div>
                            </div>

                        <% } else if (et === 'amendment' && block.data && block.data.before) { %>
                            <!-- AMENDMENT: Before/After diff panel -->
                            <div class="diff-panel">
                                <div class="diff-box">
                                    <div class="diff-box-label before">⬅ Before (Original)</div>
                                    <div class="diff-row"><span class="diff-key">Amount</span><span class="diff-val diff-changed"><%= block.data.before.currency %> <%= parseFloat(block.data.before.amount||0).toLocaleString() %></span></div>
                                    <div class="diff-row"><span class="diff-key">Type</span><span class="diff-val"><%= block.data.before.type %></span></div>
                                    <div class="diff-row"><span class="diff-key">Desc</span><span class="diff-val"><%= (block.data.before.description||'').slice(0,20) %></span></div>
                                    <div class="diff-row"><span class="diff-key">Date</span><span class="diff-val"><%= block.data.before.date %></span></div>
                                </div>
                                <div class="diff-arrow">→</div>
                                <div class="diff-box">
                                    <div class="diff-box-label after">➡ After (Edited)</div>
                                    <div class="diff-row"><span class="diff-key">Amount</span><span class="diff-val diff-changed"><%= block.data.after.currency %> <%= parseFloat(block.data.after.amount||0).toLocaleString() %></span></div>
                                    <div class="diff-row"><span class="diff-key">Type</span><span class="diff-val"><%= block.data.after.type %></span></div>
                                    <div class="diff-row"><span class="diff-key">Desc</span><span class="diff-val"><%= (block.data.after.description||'').slice(0,20) %></span></div>
                                    <div class="diff-row"><span class="diff-key">Date</span><span class="diff-val"><%= block.data.after.date %></span></div>
                                </div>
                            </div>
                            <% if (block.amendedBlockHash) { %>
                                <div class="block-field block-full-width" onclick="copyToClipboard('<%= block.amendedBlockHash %>')">
                                    <div class="block-field-label">Original Block Hash (amended)</div>
                                    <div class="block-field-value" style="color:#f59e0b; font-size:0.75rem;"><%= block.amendedBlockHash.substring(0,24) %>...</div>
                                    <div class="copy-hint">Click to copy</div>
                                </div>
                            <% } %>

                        <% } else if (et === 'deletion' && block.data && block.data.deletedSnapshot) { %>
                            <!-- DELETION: Deleted transaction snapshot -->
                            <div class="deletion-panel">
                                <div class="block-field">
                                    <div class="block-field-label">🗑 Deleted Amount</div>
                                    <div class="block-field-value" style="color:#ef4444;font-weight:700;">
                                        <%= block.data.deletedSnapshot.currency %> <%= parseFloat(block.data.deletedSnapshot.amount||0).toLocaleString() %>
                                    </div>
                                </div>
                                <div class="block-field">
                                    <div class="block-field-label">Type</div>
                                    <div class="block-field-value"><%= block.data.deletedSnapshot.type %></div>
                                </div>
                                <div class="block-field">
                                    <div class="block-field-label">Date</div>
                                    <div class="block-field-value"><%= block.data.deletedSnapshot.date %></div>
                                </div>
                                <div class="block-field">
                                    <div class="block-field-label">Description</div>
                                    <div class="block-field-value" style="font-family:inherit;"><%= block.data.deletedSnapshot.description || '—' %></div>
                                </div>
                            </div>
                            <% if (block.amendedBlockHash) { %>
                                <div class="block-field block-full-width" onclick="copyToClipboard('<%= block.amendedBlockHash %>')">
                                    <div class="block-field-label">Original Block Hash (deleted)</div>
                                    <div class="block-field-value" style="color:#ef4444; font-size:0.75rem;"><%= block.amendedBlockHash.substring(0,24) %>...</div>
                                    <div class="copy-hint">Click to copy</div>
                                </div>
                            <% } %>

                        <% } else { %>
                            <!-- Standard transaction block -->
                            <div class="block-field">
                                <div class="block-field-label">Amount</div>
                                <div class="block-field-value <%= block.data.type === 'income' ? 'amount-income' : 'amount-expense' %>">
                                    <%= block.data.type === 'income' ? '+' : '-' %><%= block.data.currency %> <%= parseFloat(block.data.amount || 0).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                </div>
                            </div>

                            <div class="block-field">
                                <div class="block-field-label">Description</div>
                                <div class="block-field-value" style="font-family: inherit; font-size: 0.88rem;">
                                    <%= block.data.description || '—' %>
                                </div>
                            </div>

                            <div class="block-field">
                                <div class="block-field-label">Transaction Date</div>
                                <div class="block-field-value"><%= block.data.date || '—' %></div>
                            </div>

                            <div class="block-field">
                                <div class="block-field-label">Nonce (PoW)</div>
                                <div class="block-field-value" style="color: var(--chain-warning);">
                                    <%= block.nonce.toLocaleString() %>
                                </div>
                            </div>

                            <div class="block-field block-full-width" onclick="copyToClipboard('<%= block.data.transactionId %>')">
                                <div class="block-field-label">Transaction ID (MongoDB)</div>
                                <div class="block-field-value" style="color: var(--text-muted); font-size: 0.75rem;">
                                    <%= block.data.transactionId %>
                                </div>
                                <div class="copy-hint">Click to copy</div>
                            </div>
                        <% } %>

                        <!-- Difficulty & Index — always shown -->
                        <div class="block-field">
                            <div class="block-field-label">Difficulty</div>
                            <div class="block-field-value" style="color: var(--chain-secondary);">
                                <%= block.difficulty %> (leading zeros)
                            </div>
                        </div>

                        <div class="block-field">
                            <div class="block-field-label">Nonce (PoW)</div>
                            <div class="block-field-value" style="color: var(--chain-warning);">
                                <%= block.nonce.toLocaleString() %>
                            </div>
                        </div>

                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-chain">
            <p style="font-size: 3rem; margin: 0;">⛓</p>
            <p style="font-size: 1.1rem; font-weight: 600; margin-top: 12px;">No blocks yet</p>
            <p style="font-size: 0.9rem; margin-top: 6px;">Add a transaction to start building the chain</p>
            <a href="/transactions" class="btn-primary" style="display: inline-flex; margin-top: 20px; gap: 8px; align-items: center;">
                <i data-lucide="plus" style="width: 16px;"></i> Add Transaction
            </a>
        </div>
    <% } %>

</div>

<!-- Copied Toast -->
<div class="copied-toast" id="copiedToast">📋 Copied to clipboard!</div>

<script>
    lucide.createIcons();

    function copyToClipboard(text) {
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
            const toast = document.getElementById('copiedToast');
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 2000);
        });
    }

    async function runVerify() {
        const btn = document.getElementById('verifyBtn');
        const banner = document.getElementById('verifyBanner');

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span> Verifying...';

        try {
            const res = await fetch('/blockchain/verify');
            const result = await res.json();

            banner.className = 'verify-banner ' + (result.valid ? 'valid' : 'invalid');
            const dot = banner.querySelector('.dot');
            const msgEl = banner.querySelector('.verify-badge span');

            if (result.valid) {
                msgEl.textContent = `Chain Integrity Verified — All ${result.blockCount} blocks are authentic`;
            } else {
                msgEl.textContent = `Chain Integrity FAILED — ${result.reason || 'Tampering detected'}`;
            }
        } catch (e) {
            alert('Error running verification: ' + e.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i data-lucide="shield-check" style="width:16px;"></i> Re-verify Chain';
            lucide.createIcons();
        }
    }
</script>

<%- include('../partials/footer') %>
